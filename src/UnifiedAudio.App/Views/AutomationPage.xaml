<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnifiedAudio.Views.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Perfiles vinculados a aplicaciones y acciones locales al cambiar mute." Style="{StaticResource SectionBodyStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar
                Title="Confianza explícita"
                Message="Ningún programa o script se ejecuta hasta que habilites la acción y marques que revisaste y confías en su contenido."
                Severity="Informational"
                IsClosable="False"
                IsOpen="True" />
            <ComboBox x:Name="ProfileBox" Header="Perfil" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ProfileBox_SelectionChanged" />

            <Expander Header="Aplicación vinculada" IsExpanded="True">
                <StackPanel Spacing="10">
                    <TextBox x:Name="LinkedApplicationBox" Header="Nombre del ejecutable" PlaceholderText="discord.exe" />
                    <ToggleSwitch x:Name="ForegroundOnlySwitch" Header="Solo cuando la aplicación esté en foreground" />
                    <NumberBox x:Name="AfkTimeoutBox" Header="Timeout AFK (ms, 0 = desactivado)" Minimum="0" Maximum="86400000" SpinButtonPlacementMode="Compact" />
                    <TextBox x:Name="AutoExitAppsBox" Header="Aplicaciones que deben cerrarse al abandonar el perfil" PlaceholderText="obs64.exe&#x0a;monitor.exe" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                    <TextBlock Text="Una aplicación por línea. UnifiedAudio solicita un cierre normal de su ventana; nunca fuerza la terminación del proceso." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <Button Content="Guardar reglas del perfil" Click="SaveRulesButton_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Expander>

            <Expander Header="Acciones de mute" IsExpanded="True">
                <StackPanel Spacing="10">
                    <ListView x:Name="ActionList" DisplayMemberPath="Name" SelectionChanged="ActionList_SelectionChanged" MinHeight="80" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Nueva acción" Click="NewActionButton_Click" />
                        <Button Content="Eliminar" Click="DeleteActionButton_Click" />
                    </StackPanel>
                    <TextBox x:Name="ActionNameBox" Header="Nombre" />
                    <ComboBox x:Name="ActionTypeBox" Header="Tipo" HorizontalAlignment="Stretch" SelectionChanged="ActionTypeBox_SelectionChanged" />
                    <TextBox x:Name="ExecutableBox" Header="Ejecutable" PlaceholderText="C:\Ruta\programa.exe" />
                    <TextBox x:Name="ArgumentsBox" Header="Argumentos" PlaceholderText="--state {state} --origin {origin}" />
                    <TextBox x:Name="PowerShellBox" Header="Script PowerShell" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />
                    <StackPanel x:Name="VoicemeeterPanel" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="VoicemeeterDllBox" Header="VoicemeeterRemote64.dll (opcional; se autodetecta)" />
                        <TextBox x:Name="VoicemeeterParameterBox" Header="Parámetro" PlaceholderText="Strip[0].Mute" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox x:Name="VoicemeeterMutedValueBox" Header="Valor muteado" Value="1" SpinButtonPlacementMode="Compact" />
                            <NumberBox x:Name="VoicemeeterUnmutedValueBox" Grid.Column="1" Header="Valor desmuteado" Value="0" SpinButtonPlacementMode="Compact" />
                        </Grid>
                    </StackPanel>
                    <NumberBox x:Name="ActionTimeoutBox" Header="Timeout (s)" Minimum="1" Maximum="300" Value="10" SpinButtonPlacementMode="Compact" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ToggleSwitch x:Name="ActionEnabledSwitch" Header="Habilitada" />
                        <ToggleSwitch x:Name="ActionTrustedSwitch" Header="Revisada y de confianza" />
                        <ToggleSwitch x:Name="RunMutedSwitch" Header="Al mutear" />
                        <ToggleSwitch x:Name="RunUnmutedSwitch" Header="Al desmutear" />
                    </StackPanel>
                    <TextBlock Text="Variables: {profile}, {state}, {isMuted}, {origin}, {inputDevice}, {outputDevice}." Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                    <Button Content="Guardar acción" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveActionButton_Click" />
                </StackPanel>
            </Expander>

            <InfoBar
                Title="Adaptadores opcionales aún no cargados"
                Message="Voicemeeter se habilita como acción opcional mediante su Remote DLL instalada. Aura Sync permanece desactivado sin un SDK/licencia redistribuible verificado."
                Severity="Warning"
                IsClosable="False"
                IsOpen="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
