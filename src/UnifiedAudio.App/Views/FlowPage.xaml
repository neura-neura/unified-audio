<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnifiedAudio.Views.FlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel
            HorizontalAlignment="Stretch"
            Padding="{StaticResource PagePadding}"
            Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SectionBodyStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="True" />

            <ItemsRepeater
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind Nodes}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinItemHeight="168"
                        MinItemWidth="248"
                        MinColumnSpacing="16"
                        MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button
                            HorizontalAlignment="Stretch"
                            Margin="0"
                            MinHeight="168"
                            Padding="16"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding AccessibleName}"
                            Click="Node_Click"
                            Tag="{Binding Route}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{Binding Glyph}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding Detail}"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    Grid.Row="3"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Level}"
                                    AutomationProperties.Name="{Binding MeterName}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
