<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnifiedAudio.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Estado reproducible del motor, contadores y acceso a logs locales. UnifiedAudio no graba ni sube audio." Style="{StaticResource SectionBodyStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />
            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Motor" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="EngineState" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="Mute" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="MuteState" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="VST3" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="PluginState" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="Input peak" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="InputPeak" Grid.Row="3" Grid.Column="1" />
                    <TextBlock Grid.Row="4" Text="Voice peak (post-VST/mute)" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="VoicePeak" Grid.Row="4" Grid.Column="1" />
                    <TextBlock Grid.Row="5" Text="System peak" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="SystemPeak" Grid.Row="5" Grid.Column="1" />
                    <TextBlock Grid.Row="6" Text="Output peak" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="OutputPeak" Grid.Row="6" Grid.Column="1" />
                    <TextBlock Grid.Row="7" Text="Endpoints abiertos" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="EndpointState" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="8" Text="IDs MMDevice" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="EndpointIds" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="9" Text="Contrato" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Grid.Row="9" Grid.Column="1" Text="Engine v1" />
                    <TextBlock Grid.Row="10" Text="Frecuencias" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="RatesState" Grid.Row="10" Grid.Column="1" />
                    <TextBlock Grid.Row="11" Text="Prebuffer" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="QueueState" Grid.Row="11" Grid.Column="1" />
                    <TextBlock Grid.Row="12" Text="XRuns" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="XrunState" Grid.Row="12" Grid.Column="1" />
                    <TextBlock Grid.Row="13" Text="Ruta de feedback" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="FeedbackState" Grid.Row="13" Grid.Column="1" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="14" Text="Protección" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock x:Name="FeedbackGuardState" Grid.Row="14" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Actualizar estado" Click="RefreshButton_Click" />
                <Button Content="Abrir carpeta de logs" Click="OpenLogsButton_Click" />
                <Button Content="Copiar logs" Click="CopyLogsButton_Click" />
                <Button Content="Limpiar logs" Click="ClearLogsButton_Click" />
                <Button Content="Panel de grabación de Windows" Click="OpenRecordingPanelButton_Click" />
            </StackPanel>
            <TextBox x:Name="LogText" Header="Logs de aplicación y motor" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="180" MaxHeight="360" FontFamily="Consolas" AutomationProperties.Name="Logs de UnifiedAudio" />
        </StackPanel>
    </ScrollViewer>
</Page>
