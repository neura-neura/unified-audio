<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnifiedAudio.Views.MixerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UnifiedAudio.Views"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Configura qué llega al endpoint virtual final y cuánto aporta cada fuente." Style="{StaticResource SectionBodyStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" />

            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <RadioButtons x:Name="ModeButtons" Header="Modo" SelectedIndex="0">
                    <x:String>Voz</x:String>
                    <x:String>Audio del PC</x:String>
                    <x:String>Ambos</x:String>
                </RadioButtons>
                <ComboBox x:Name="SystemDeviceBox" Grid.Column="1" Header="Endpoint de audio del sistema" HorizontalAlignment="Stretch" AutomationProperties.Name="Endpoint de audio del sistema" SelectionChanged="SystemDeviceBox_SelectionChanged" />
            </Grid>

            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Slider x:Name="VoiceSlider" Header="Volumen de voz" Minimum="0" Maximum="400" Value="100" ValueChanged="GainSlider_ValueChanged" AutomationProperties.Name="Volumen de voz" />
                <TextBlock x:Name="VoiceValueText" Grid.Column="1" VerticalAlignment="Bottom" />
                <Slider x:Name="SystemSlider" Grid.Row="1" Header="Volumen de audio del PC" Minimum="0" Maximum="400" Value="100" ValueChanged="GainSlider_ValueChanged" AutomationProperties.Name="Volumen de audio del PC" />
                <TextBlock x:Name="SystemValueText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" />
            </Grid>

            <Expander Header="Ducking" IsExpanded="True">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="DuckingSwitch" Header="Bajar audio del PC cuando hablo" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <NumberBox x:Name="DuckAmountBox" Header="Cantidad (%)" Minimum="0" Maximum="100" Value="55" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="ThresholdBox" Grid.Column="1" Header="Umbral de voz (dBFS)" Minimum="-80" Maximum="0" Value="-36" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="AttackBox" Grid.Column="2" Header="Ataque (ms)" Minimum="0" Maximum="5000" Value="20" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="HoldBox" Grid.Row="1" Header="Hold (ms)" Minimum="0" Maximum="10000" Value="200" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="ReleaseBox" Grid.Row="1" Grid.Column="1" Header="Release (ms)" Minimum="0" Maximum="10000" Value="280" SpinButtonPlacementMode="Compact" />
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Header="Filtrado por aplicación" IsExpanded="True">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="ProcessFilterSwitch"
                                  Header="Activar filtrado por aplicación"
                                  AutomationProperties.Name="Activar filtrado por aplicación" />
                    <ComboBox x:Name="ProcessFilterModeBox" Header="Política para aplicaciones nuevas" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Solo las marcadas: las no marcadas quedan fuera. Todas salvo las desmarcadas: las aplicaciones nuevas entran automáticamente. Cada regla se conserva aunque la aplicación se cierre."
                               Style="{StaticResource SectionBodyStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SessionSummaryText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="Actualizar aplicaciones" Click="RefreshSessionsButton_Click" AutomationProperties.Name="Actualizar aplicaciones de audio" />
                    </Grid>
                    <ListView x:Name="SessionList" ItemsSource="{x:Bind SessionRows}" SelectionMode="None" MaxHeight="360" AutomationProperties.Name="Aplicaciones de audio">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AppSessionRow">
                                <Grid Padding="4" ColumnSpacing="12" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Included, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{x:Bind Peak, Mode=OneWay}" Minimum="0" Maximum="1" AutomationProperties.Name="{x:Bind MeterAccessibleName, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        <Slider Header="{x:Bind GainHeader, Mode=OneWay}" Minimum="0" Maximum="400"
                                                Value="{x:Bind GainPercent, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind GainAccessibleName, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Expander>

            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock Text="Medidores reales" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar x:Name="VoiceMeter" Minimum="0" Maximum="1" AutomationProperties.Name="Nivel de voz" />
                    <ProgressBar x:Name="SystemMeter" Minimum="0" Maximum="1" AutomationProperties.Name="Nivel de sistema" />
                    <ProgressBar x:Name="OutputMeter" Minimum="0" Maximum="1" AutomationProperties.Name="Nivel final" />
                    <TextBlock Text="Espectro de salida · 60 Hz–16 kHz" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Canvas x:Name="SpectrumCanvas" Height="96" SizeChanged="SpectrumCanvas_SizeChanged" AutomationProperties.Name="Espectro de salida de 16 bandas">
                        <Polyline x:Name="SpectrumLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" />
                    </Canvas>
                    <TextBlock x:Name="TelemetryText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button x:Name="ApplyButton" Content="Aplicar al motor" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="ApplyButton_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
